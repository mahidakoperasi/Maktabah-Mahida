# PostgreSQL
# Required at runtime and by migration commands.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Authentication
# Use a long random value in production (at least 32 bytes of entropy).
JWT_SECRET=replace-with-a-long-random-secret

# Optional: enables public-folder photo discovery in Admin Gallery.
# Enable Google Drive API; restrict this key to Drive API and the VPS outgoing IP.
# NEVER prefix with NEXT_PUBLIC_ or enter the key in the Admin web form.
GOOGLE_DRIVE_API_KEY=

# Optional private Google Docs integration. Enable Google Docs API and share
# source documents as Viewer with the service account's client_email.
# Use ONE credential method. Never use NEXT_PUBLIC_ or commit real credentials.
# JSON must be a single line in a Docker --env-file; escaped newlines stay inside JSON.
GOOGLE_DOCS_SERVICE_ACCOUNT_JSON=
# Alternatively mount a readable secret file into the app container:
# GOOGLE_DOCS_CREDENTIALS_FILE=/run/secrets/google-docs.json
# Alternatively set these two fields (PEM newlines encoded as literal \n):
# GOOGLE_DOCS_CLIENT_EMAIL=
# GOOGLE_DOCS_PRIVATE_KEY=
# Automatic checks run every two minutes in the Node server, including paused sources.
# MAKTABAH_SYNC_ENABLED=true
# Optional bearer secret for an external scheduler calling POST /api/internal/maktabah/sync:
# MAKTABAH_SYNC_SECRET=

# Optional runtime settings. Most platforms provide these automatically.
# NODE_ENV=production
# PORT=3000
# HOSTNAME=0.0.0.0
