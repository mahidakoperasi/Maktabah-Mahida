# PostgreSQL
# Required at runtime and by migration commands.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Authentication
# Use a long random value in production (at least 32 bytes of entropy).
JWT_SECRET=replace-with-a-long-random-secret

# OTP email delivery over HTTPS (works on hosts that block outbound SMTP).
RESEND_API_KEY=re_replace-with-email-api-key
EMAIL_FROM=Mahida Digital <no-reply@example.com>

# Optional runtime settings. Most platforms provide these automatically.
# NODE_ENV=production
# PORT=3000
# HOSTNAME=0.0.0.0
