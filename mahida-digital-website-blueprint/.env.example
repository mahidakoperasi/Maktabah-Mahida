# PostgreSQL
# Required by the application and migration commands.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Authentication
# Use a long random value in production (at least 32 bytes of entropy).
JWT_SECRET=replace-with-a-long-random-secret

# SMTP email delivery for OTP verification
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=no-reply@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=Mahida Digital <no-reply@example.com>

# Optional runtime marker. Hosting providers normally set this automatically.
# NODE_ENV=production
